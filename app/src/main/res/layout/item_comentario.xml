<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">


        <TextView
            android:id="@+id/tvPartidoComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En: Partido de ejemplo"
            android:textColor="#FF8000"
            android:textSize="14sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvTextoComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Aquí va el texto de tu comentario..."
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvFechaComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Publicado hace un momento"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>